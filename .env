# Copy this file to .env and fill in values as needed.
# - server.js (npm start) reads this directly — no build step required.
# - js/config.js's TMDB key / tuning knobs need `npm run build` to apply.
# On Render, set these in the dashboard's Environment tab instead — see
# DEPLOY.md — though a committed .env would work too if you don't mind it
# being in your repo.

# ---- Proxy target (fixes CORS) ----
# The real backend server.js forwards /api-proxy/* requests to. Defaults to
# https://ucapi-jtrl.onrender.com if unset, so this is optional unless
# you're pointing at a different backend.
# OTTFREE_API_URL=https://varying-orsa-komi106-7ef913ad.koyeb.app

# Set to "false" to disable the proxy and call OTTFREE_API_URL directly from
# the browser instead (requires the backend to send proper CORS headers).
OTTFREE_USE_PROXY=true

# ---- Frontend config (baked into js/config.js via `npm run build`) ----
# Free TMDb key: https://www.themoviedb.org/settings/api
# Either the "API Key (v3 auth)" or the "API Read Access Token" (v4) works —
# tmdbFetch in js/utils.js auto-detects which one you pasted.
# OTTFREE_TMDB_API_KEY=68be78e728be4e86e934df1591d26c5b

# Optional tuning knobs — safe to leave unset (defaults live in js/config.js).
# OTTFREE_HOME_CHANNEL_SAMPLE=3
# OTTFREE_MAX_EPISODE_SCAN_PAGES=6

# ---- Server ----
# Port server.js listens on locally. Render sets its own PORT automatically
# and that always takes priority over this.
# OTTFREE_PORT=8080

# How long (ms) server.js caches safe GET API responses before re-asking the
# backend. Set to 0 to disable caching entirely.
# OTTFREE_CACHE_TTL_MS=20000
